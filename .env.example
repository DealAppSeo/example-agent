# Optional — the example runs WITHOUT any of these (keyless demo mode against the public HAL endpoint).
# Set BOTH to switch to SDK mode (full HAL + RepID loop for your agent):
# AGENT_ID=your-agent-id
# TRUSTSHELL_API_KEY=ts_live_...        # request at: https://github.com/DealAppSeo/trustshell/issues/new?template=api_key_request.yml

# Override the engine (defaults to production):
# TRUSTSHELL_ENGINE=https://repid-engine-production.up.railway.app
# PORT=3000
